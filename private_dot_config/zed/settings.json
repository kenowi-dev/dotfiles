// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"auto_install_extensions": {
		"git-firefly": true,
		"html": true,
		"intellij-newui-theme": true,
		"material-icon-theme": true,
		"svelte": true,
		"toml": true,
	},
	"agent_ui_font_size": 16.0,
	"proxy": "",
	"agent_ui_font_family": ".ZedSans",
	"context_servers": {
		"Svelte MCP": {
			"enabled": true,
			"url": "https://mcp.svelte.dev/mcp",
			"timeout": 10,
		},
	},
	"outline_panel": {
		"dock": "left",
	},
	"collaboration_panel": {
		"dock": "left",
	},
	"agent": {
		"threads_sidebar": {
			"position": "right",
		},
		"play_sound_when_agent_done": "when_hidden",
		"tool_permissions": {
			"tools": {
				"skill": {
					"default": "allow",
				},
				"create_directory": {
					"always_allow": [
						{
							"pattern": "^watchlist/src/lib/components/ui-2/",
						},
					],
				},
				"terminal": {
					"always_allow": [
						{
							"pattern": "^ls\\s+node_modules/phosphor-svelte/lib(\\s|$)",
						},
						{
							"pattern": "^head\\b",
						},
						{
							"pattern": "^grep\\b",
						},
						{
							"pattern": "^bun\\s+x(\\s|$)",
						},
						{
							"pattern": "^tail\\b",
						},
						{
							"pattern": "^wc\\b",
						},
						{
							"pattern": "^bun\\s+run(\\s|$)",
						},
						{
							"pattern": "^echo\\s+NO(\\s|$)",
						},
						{
							"pattern": "^sort\\b",
						},
						{
							"pattern": "^git\\s+status(\\s|$)",
						},
						{
							"pattern": "^echo\\b",
						},
						{
							"pattern": "^ls\\b",
						},
					],
				},
				"mcp:Svelte MCP:svelte-autofixer": {
					"default": "allow",
				},
				"mcp:Svelte MCP:get-documentation": {
					"default": "allow",
				},
				"mcp:Svelte MCP:list-sections": {
					"default": "allow",
				},
			},
		},
		"default_profile": "write",
		"default_model": {
			"effort": "high",
			"provider": "openrouter",
			"model": "deepseek/deepseek-v4.1-flash-1017",
			"enable_thinking": true,
		},
		"dock": "right",
		"favorite_models": [],
		"model_parameters": [],
	},
	"git_panel": {
		"dock": "left",
	},
	"$schema": "zed://schemas/settings",
	"project_panel": {
		"dock": "left",
		"hide_root": true,
		"diagnostic_badges": true,
		"bold_folder_labels": true,
	},
	"diagnostics": {
		"inline": {
			"enabled": true,
		},
	},
	"terminal": {
		"font_weight": 400,
		"font_family": "JetBrainsMono Nerd Font",
	},
	"tabs": {
		"file_icons": true,
		"git_status": true,
	},
	"title_bar": {
		"show_branch_status_icon": true,
		"show_menus": false,
	},
	"autosave": {
		"after_delay": {
			"milliseconds": 1000,
		},
	},
	"auto_indent": "syntax_aware",
	"auto_indent_on_paste": true,
	"show_completion_documentation": true,
	"format_on_save": "on",
	"tab_size": 4,
	"hard_tabs": true,
	"disable_ai": false,
	"buffer_font_family": "JetBrains Mono",
	"buffer_font_features": {
		"calt": true,
		"liga": true,
	},
	"icon_theme": {
		"mode": "system",
		"light": "Material Icon Theme",
		"dark": "Material Icon Theme",
	},
	"base_keymap": "JetBrains",
	"ui_font_size": 16,
	"buffer_font_size": 14,
	"theme": {
		"mode": "system",
		"light": "One Light",
		"dark": "JetBrains New Dark",
	},
	"semantic_tokens": "combined",
	"soft_wrap": "none",
	"preferred_line_length": 120,
	"inlay_hints": {
		"edit_debounce_ms": 500,
		"show_background": false,
		"show_type_hints": true,
		"show_parameter_hints": false,
		"toggle_on_modifiers_press": {
			"alt": true,
		},
		"enabled": false,
	},
	"lsp": {
		"biome": {
			"settings": { "require_config_file": true, "config_path": "./biome.json" },
		},
		"vscode-html-language-server": {
			"settings": {
				"html": {
					"format": {
						// Indent under <html> and <head> (default: false)
						"indentInnerHtml": true,
						// Disable formatting inside <svg> or <script>
						"contentUnformatted": "svg,script",
						// Add an extra newline before <div> and <p>
						"extraLiners": "div,p",
					},
				},
			},
		},
		"tailwindcss-language-server": {
			"settings": {
				"experimental": {
					"classRegex": ["class=\"([^\"]*)\""],
				},
			},
		},
	},

	"languages": {
		"YAML": {
			"hard_tabs": false,
			"tab_size": 2,
		},

		"CSS": {
			"language_servers": ["tailwindcss-language-server"],
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
			},
		},
		"HTML": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
			},
		},
		"JSON": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
			},
		},
		"JavaScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
			},
		},
		"Svelte": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": false,
				"source.organizeImports.biome": true,
			},
		},
		"TSX": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
			},
		},
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"language_servers": ["biome", "tsgo", "vtsls"],
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
			},
		},
	},
}
