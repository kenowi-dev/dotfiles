{{- $files := printf "%s/%s" .chezmoi.sourceDir "private_dot_config/zed/.mcp/*.toml" | glob }}
{{- $entries := list }}
{{- range $file := $files }}
    {{- $mcps := fromToml (includeTemplate $file $) -}}
    {{- range $name, $mcp := $mcps }}
        {{- if hasKey $mcp "config" }}
            {{- $entry := printf "\n    %s: %s" ($name | toJson) ($mcp.config | toPrettyJson | indent 4 | trim) }}
            {{- $entries = append $entries $entry }}
        {{- end }}
    {{- end }}
{{- end }}
{{- join "," $entries -}}
